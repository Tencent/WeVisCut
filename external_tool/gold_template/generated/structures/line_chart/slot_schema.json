{
  "structure_id": "line_chart",
  "family": "dataviz",
  "duration_default": 7.0,
  "slots": {
    "headline": {
      "type": "string",
      "label": "图表标题",
      "default": "年度用户增长趋势",
      "max_chars": 18
    },
    "series": {
      "type": "json",
      "label": "数据系列",
      "default": [
        { "x": "1月", "y": 12 },
        { "x": "3月", "y": 28 },
        { "x": "5月", "y": 45 },
        { "x": "7月", "y": 38 },
        { "x": "9月", "y": 56 },
        { "x": "12月", "y": 72 }
      ]
    },
    "x_label": {
      "type": "string",
      "label": "X轴标签",
      "default": "月份",
      "max_chars": 8
    },
    "y_label": {
      "type": "string",
      "label": "Y轴标签",
      "default": "万人",
      "max_chars": 8
    },
    "source_note": {
      "type": "string",
      "label": "数据来源",
      "default": "数据来源：内部统计 2024",
      "max_chars": 24
    }
  },
  "data_slots": ["series"]
}
