{
  "structure_id": "metric_cards",
  "family": "dataviz",
  "display_name": "关键数字",
  "use_for": ["关键数字", "惊人比例", "核心指标"],
  "spotlight_level": "high",
  "duration_range": [5.0, 8.0],
  "anim_roles": ["bg", "title", "card", "stat", "unit", "card-label", "accent-line"],
  "slots": ["headline", "metrics"],
  "data_slots": ["metrics"],
  "data_contract": {
    "metrics": { "shape": "[{value: number, unit: string, label: string}]", "min_items": 2, "max_items": 4 }
  },
  "bound": true,
  "sfx_cues": [
    { "at": 0.2, "sfx": "pop", "comment": "卡片弹出" },
    { "at": 1.0, "sfx": "rise", "comment": "数字飙升到位" }
  ]
}
